# Production settings. Copy to `.env` next to compose.yml on the VPS (chmod 600) and fill in.
# Never commit the real file. Generate secrets with: openssl rand -hex 32

# Public hostname (the NPM Proxy Host domain) and the exact public origin. ORIGIN must be
# https://<DOMAIN>: SvelteKit's CSRF check and the /api Origin check compare against it.
DOMAIN=kitchen.example.com
ORIGIN=https://kitchen.example.com

# Database password for the private kitchen-care postgres container. Only A-Z a-z 0-9 _ . ~ -
POSTGRES_PASSWORD=

# At least 32 characters.
SESSION_SECRET=

# IANA timezone used to bucket analytics by day/hour/weekday. Defaults in code to UTC; set YOUR
# office timezone (the VPS host uses Europe/Berlin; confirm it is right for your office).
APP_TIMEZONE=Europe/Berlin

# Docker network that Nginx Proxy Manager is attached to (proxy-net on the VPS). Check it with
# `docker network ls` and `docker inspect <npm container> --format '{{json .NetworkSettings.Networks}}'`.
NPM_NETWORK=proxy-net

# Optional. CIDR(s), comma separated, allowed to set the client IP via X-Forwarded-For (i.e. NPM's
# network). Auto-detected from NPM_NETWORK when empty.
NPM_SUBNET=172.18.0.0/16

# Optional. Where backup.sh writes dumps (default /var/backups/kitchen-care).
BACKUP_DIR=/var/backups/kitchen-care

# Only with compose.hostport.yml (NPM reaching the proxy by host port): add
#   COMPOSE_FILE=compose.yml:compose.hostport.yml
#   PROXY_HOST_PORT=8081
