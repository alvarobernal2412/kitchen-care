# Copy to .env next to docker-compose.yml on the VPS and chmod 600. Never commit the real file.
# Use ONE of the two, not both.

# Recommended for an ephemeral runner: a personal access token (fine-grained, this repository only,
# permission "Administration: Read and write") or a classic token with the `repo` scope. The runner
# uses it to request a fresh registration token each time it restarts.
ACCESS_TOKEN=<personal-access-token>

# Alternative: a one-shot registration token (Settings > Actions > Runners > New self-hosted
# runner). It expires after about an hour, so it only works for the first registration; an
# ephemeral runner that restarts after each job needs ACCESS_TOKEN instead.
#RUNNER_TOKEN=<registration-token>
