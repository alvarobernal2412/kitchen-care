# Self-hosted GitHub Actions runner for the deploy job, running as a container on the VPS.
# Copy this folder to the VPS (e.g. /opt/kitchen-care-runner), rename this file to
# docker-compose.yml, fill in <owner>/<repo> and <docker-gid>, create .env from .env.example.
# Docker-outside-of-docker: the runner talks to the host's Docker daemon through the socket, so the
# deploy directory must be mounted at the SAME absolute path inside the container; compose then
# resolves its bind mounts (./deploy/nginx, ./state) to paths the host daemon understands.
#
# The runner is EPHEMERAL: it takes one job, then exits and must register again with a fresh
# registration. `restart: unless-stopped` alone re-registers on the next start only if the
# container actually restarts; supervise it with a small systemd unit (see deploy/README.md).
name: kitchen-care-runner

services:
  kitchen-care-runner:
    image: myoung34/github-runner:latest
    container_name: kitchen-care-runner
    restart: unless-stopped
    mem_limit: 1g
    cpus: 1.0
    env_file: .env # ACCESS_TOKEN or RUNNER_TOKEN, see .env.example
    environment:
      RUNNER_SCOPE: repo
      REPO_URL: https://github.com/<owner>/<repo>
      RUNNER_NAME: kitchen-care-runner-1
      LABELS: self-hosted,kitchen-care
      EPHEMERAL: 'true'
      RUNNER_WORKDIR: /tmp/kitchen-care-runner
      # git refuses to work in a clone owned by another user ("dubious ownership"); the runner
      # runs as root in the container while the clone belongs to whoever created it on the host.
      GIT_CONFIG_COUNT: '1'
      GIT_CONFIG_KEY_0: safe.directory
      GIT_CONFIG_VALUE_0: /opt/kitchen-care
    group_add:
      - '<docker-gid>' # numeric gid of the host's docker group: getent group docker | cut -d: -f3
    extra_hosts:
      - host.docker.internal:host-gateway
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # The deploy clone, at the same path inside and outside the container.
      - /opt/kitchen-care:/opt/kitchen-care
      # Optional: only if the repository is private and the clone uses an SSH deploy key.
      - /root/.ssh:/root/.ssh:ro
