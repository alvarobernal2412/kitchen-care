DATABASE_URL=postgres://kitchen:kitchen@localhost:5432/kitchen
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_BOOTSTRAP_USERNAME=admin
UPLOAD_DIR=./uploads
# IANA timezone used to bucket analytics by day/hour/weekday, e.g. Europe/Zurich (invalid values fall back to UTC)
APP_TIMEZONE=UTC
# Optional. New accounts created before this instant get a one-time welcome bonus of 10 credits
# (only while a period is active). ISO-8601 with an offset or Z. Unset or empty uses the default,
# 2026-11-20T00:00:00+01:00 (20 November 2026, 00:00 in Europe/Zurich); an invalid value logs a
# warning and also uses the default; a past value turns the bonus off.
#WELCOME_BONUS_UNTIL=2026-11-20T00:00:00+01:00
